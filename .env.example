# JPGFLY runtime
JPGFLY_AUTONOMOUS_STUDIO=true
# Legacy compatibility variable. Candidate Fly Brain remains the sole painting authority.
JPGFLY_BRAIN_PROVIDER=procedural
JPGFLY_TEXT_PROVIDER=procedural  # procedural | flm | ollama | hybrid
JPGFLY_DATA_DIR=
JPGFLY_PUBLIC_DEPLOYMENT=false
JPGFLY_ALLOW_EPHEMERAL_STORAGE=false

# Ollama visual-first reasoning / composition model
JPGFLY_OLLAMA_URL=http://127.0.0.1:11434
JPGFLY_OLLAMA_MODEL=qwen3-vl:8b-instruct-q4_K_M
JPGFLY_VISION_MODEL=qwen3-vl:8b-instruct-q4_K_M
JPGFLY_ALLOWED_OLLAMA_MODELS=qwen3-vl:8b-instruct-q4_K_M
JPGFLY_OLLAMA_AUTH_TOKEN=

# Optional MaleCNS bias service
JPGFLY_MALECNS_ENABLED=false
JPGFLY_MALECNS_URL=http://127.0.0.1:4690
JPGFLY_MALECNS_TIMEOUT=12
JPGFLY_MALECNS_STRENGTH=0.22

# Optional ZebraCNS service / critic telemetry
JPGFLY_ZEBRACNS_ENABLED=false
JPGFLY_ZEBRACNS_URL=http://127.0.0.1:4770
# In-loop critic pressure. Zebra influences candidate ranking/finish timing,
# while the Fly remains the final actor. Runtime clamps this to 0.00-0.40.
JPGFLY_ZEBRACNS_STRENGTH=0.26

# Optional FLM bridge
JPGFLY_FLM_URL=http://127.0.0.1:4680
JPGFLY_FLM_TIMEOUT=180
JPGFLY_FLM_MAX_TOKENS=460
JPGFLY_FLM_LIVE_TOKENS=180
# Required if JPGFLY_FLM_URL points to a remote/private-network bridge.
JPGFLY_FLM_AUTH_TOKEN=

# Optional HTTP control protection.
# Use a long random value in the real environment; never commit it.
JPGFLY_CONTROL_TOKEN=

# Set true only behind real HTTPS.
JPGFLY_HTTPS_ONLY=false

# FLM bridge stays local by default.
JPGFLY_FLM_BRIDGE_HOST=127.0.0.1
JPGFLY_FLM_BRIDGE_PORT=4680
JPGFLY_FLM_BRIDGE_ALLOW_REMOTE=false
